<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="noExcludeDescendants"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/usage_note"
            android:textColor="#555555" />

        <EditText
            android:id="@+id/appKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/pusher_app_key"
            android:inputType="textVisiblePassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/cluster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pusher_cluster"
            android:inputType="textVisiblePassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/printerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/printer_host"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/printerPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/printer_port"
            android:inputType="number"
            android:singleLine="true" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop" />

        <Button
            android:id="@+id/testPrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_print" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/status_stopped"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/recent_log"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F2F2F2"
            android:fontFamily="monospace"
            android:minHeight="160dp"
            android:padding="10dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
